PORT=3000
NODE_ENV=development
# PostgreSQL database URL from your hosting provider:
DATABASE_URL=postgresql://username:password@localhost:5432/furqan_attendance
# Generate a long random value; do not share it:
SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_chars
# First startup admin account (created only if no admin exists):
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisPassword_Immediately_123!
# Optional Telegram alerts. Leave blank to disable:
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
